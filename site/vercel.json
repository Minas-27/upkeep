{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/app/engine.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/#demo",
      "permanent": false
    },
    {
      "source": "/app/(.*)",
      "destination": "/#demo",
      "permanent": false
    }
  ]
}
